* text=auto eol=lf
*.py text eol=lf
# Two machines changing the same task merge field by field (tools/tasks.py
# merge-driver, registered by `tasks.py sync`) instead of stopping on a conflict.
Tasks/**/*.md merge=task-vault
Archive/**/*.md merge=task-vault
# Journal pages, notes and lists merge line by line: entries added on two
# machines are both kept. Their frontmatter never changes after creation.
Journal/**/*.md merge=union
Notes/**/*.md merge=union
Lists/**/*.md merge=union
# Goals change over time (status, progress): field by field, like tasks.
Goals/**/*.md merge=task-vault
# Review pages: the generated block is rewritten by `review`, the rest is people's text.
Reviews/**/*.md merge=union
